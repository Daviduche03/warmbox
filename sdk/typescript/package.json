    "directory": "sdk/typescript"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=2 test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": { "typescript": "~5.9.3" }
