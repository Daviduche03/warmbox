{
  "name": "warmbox",
  "version": "0.5.3",
  "description": "Typed TypeScript client for the warmbox REST API",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
