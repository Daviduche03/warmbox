#!/bin/sh
# warmbox-app — install/run first-class apps inside the guest.
#
# An "app" is a directory with an app.json (id, name, command, icon,
# description). Installing copies it to /opt/apps/<id>/ and drops a menu entry
# in /usr/share/applications, so it shows up in the XFCE menu like any program.
# Since /opt and /usr/share live on the writable volume, installed apps persist
# and clone/snapshot with the machine.
set -eu

APPS_DIR=/opt/apps
DESKTOP_DIR=/usr/share/applications

usage() {
    echo "usage: warmbox-app <install <dir> | list | run <id> | remove <id>>" >&2
}

# field <file> <key>: print the first quoted value for key.
field() {
    sed -n 's/.*"'"$2"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$1" | head -1
}

cmd_install() {
    src=$1
    [ -f "$src/app.json" ] || { echo "no app.json in $src" >&2; exit 1; }
    id=$(field "$src/app.json" id)
    name=$(field "$src/app.json" name)
    command=$(field "$src/app.json" command)
    icon=$(field "$src/app.json" icon)
    desc=$(field "$src/app.json" description)
    [ -n "$id" ] || { echo "app.json needs an \"id\"" >&2; exit 1; }
    [ -n "$command" ] || { echo "app.json needs a \"command\"" >&2; exit 1; }

    mkdir -p "$APPS_DIR/$id"
    cp -R "$src/." "$APPS_DIR/$id/"
    chmod +x "$APPS_DIR/$id"/*.sh 2>/dev/null || true

    mkdir -p "$DESKTOP_DIR"
    cat > "$DESKTOP_DIR/$id.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=$name
Comment=$desc
Exec=$command
Icon=${icon:-application-x-executable}
Terminal=false
Categories=Utility;
EOF
    command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$DESKTOP_DIR" 2>/dev/null || true
    echo "installed ${name:-$id} ($id)"
}

cmd_list() {
    found=0
    for d in "$APPS_DIR"/*/; do
        [ -f "$d/app.json" ] || continue
        found=1
        echo "$(basename "$d")	$(field "$d/app.json" name)"
    done
    [ "$found" = "1" ] || echo "(no apps)"
}

cmd_run() {
    id=$1
    [ -x "$APPS_DIR/$id/run.sh" ] || { echo "no run.sh for $id" >&2; exit 1; }
    exec "$APPS_DIR/$id/run.sh"
}

cmd_remove() {
    id=$1
    rm -rf "$APPS_DIR/$id" "$DESKTOP_DIR/$id.desktop"
    command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$DESKTOP_DIR" 2>/dev/null || true
    echo "removed $id"
}

case "${1:-}" in
    install) shift; cmd_install "$@";;
    list)    cmd_list;;
    run)     shift; cmd_run "$@";;
    remove)  shift; cmd_remove "$@";;
    *)       usage; exit 1;;
esac
